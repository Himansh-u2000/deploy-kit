{
  "name": "deploykit-cli",
  "version": "2.0.0",
  "description": "One-command VPS deployment CLI — automates server setup, Node.js deployment, Nginx, PM2, and SSL on Ubuntu servers",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "deploykit": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "deploy",
    "vps",
    "deployment",
    "nginx",
    "pm2",
    "ssl",
    "ubuntu",
    "digitalocean",
    "droplet",
    "devops",
    "cli",
    "server",
    "automation",
    "node",
    "certbot",
    "lets-encrypt"
  ],
  "author": "Himanshu Haldar (https://github.com/Himansh-u2000)",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himansh-u2000/deploy-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Himansh-u2000/deploy-kit/issues"
  },
  "homepage": "https://github.com/Himansh-u2000/deploy-kit#readme",
  "files": [
    "bin/",
    "src/",
    "install.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
